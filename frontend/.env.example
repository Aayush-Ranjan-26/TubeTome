# Supabase project credentials (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Public URL of the deployed site (OAuth redirect target). Optional — defaults to window.location.origin.
# VITE_SITE_URL=https://tube-tome.vercel.app

# Backend origin (the deployed API).
# Must be listed here at build time so the CSP in index.html allows it.
# VITE_API_URL=https://your-backend.example.com
